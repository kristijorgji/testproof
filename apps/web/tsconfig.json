{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "es2023"],
        "jsx": "preserve",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "plugins": [{ "name": "next" }],
        "paths": { "@/*": ["./src/*"] },
        "allowJs": false,
        "incremental": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx", "next-env.d.ts"],
    "exclude": ["node_modules"]
}
