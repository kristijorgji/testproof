{
  "name": "@testproof/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src .storybook test --max-warnings 0",
    "fix": "eslint src .storybook test --fix",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "clean": "rm -rf .next storybook-static"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@tanstack/react-query": "^5.99.0",
    "@testproof/core": "workspace:*",
    "@testproof/db": "workspace:*",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "octokit": "^5.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@testproof/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
