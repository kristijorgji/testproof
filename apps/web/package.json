    "@testproof/core": "workspace:*",
    "@testproof/db": "workspace:*",
    "better-auth": "^1.7.18",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "i18next": "^27.1.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "octokit": "^5.0.5",
