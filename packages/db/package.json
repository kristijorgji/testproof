{
    "name": "@testproof/db",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "fix": "eslint src --fix",
        "test": "vitest run --passWithNoTests",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
