{
    "name": "@testproof/core",
    "version": "0.1.0",
    "description": "Testproof ledger schema, YAML round-trip editing, coverage derivation and renderers",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./parse": {
            "types": "./dist/parse.d.ts",
            "import": "./dist/parse.js",
            "default": "./dist/parse.js"
        },
        "./platforms": {
            "types": "./dist/platforms.d.ts",
            "import": "./dist/platforms.js",
            "default": "./dist/platforms.js"
        }
    },
    "files": ["dist"],
    "scripts": {
        "prepare": "tsc -p tsconfig.build.json",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "fix": "eslint src test --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
