{
  "name": "testproof-workspace",
  "private": true,
  "type": "module",
  "description": "Git-native test case management",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "fix": "turbo fix && prettier --write .",
    "db:generate": "pnpm --filter @testproof/db db:generate",
    "db:migrate": "pnpm --filter @testproof/db db:migrate",
    "db:seed": "pnpm --filter @testproof/db build && pnpm --filter @testproof/db db:seed",
    "storybook": "pnpm --filter @testproof/web storybook",
    "set-version": "node scripts/set-version.mjs",
    "knip": "knip",
    "prepare": "husky && tsx scripts/sync-agent-skills.ts",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "knip": "^6.32.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  }
}
